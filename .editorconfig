root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
end_of_line = lf

[*.ps1]
end_of_line = crlf

[*.{ini,js,json,json5,properties,snbt,toml}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
