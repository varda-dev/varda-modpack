{
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.associations": {
    "*.ini": "ini",
    "*.json5": "jsonc",
    "*.properties": "properties",
    "*.sh": "shellscript",
    "*.snbt": "snbt",
    "*.toml": "toml",
    "*.ps1": "powershell",
    "*.py": "python"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "[shellscript]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "files.eol": "\n"
  },
  "[markdown]": {
    "files.eol": "\n",
    "files.trimTrailingWhitespace": false
  },
  "[ini]": {
    "files.eol": "\n"
  },
  "[javascript]": {
    "files.eol": "\n"
  },
  "[json]": {
    "files.eol": "\n"
  },
  "[jsonc]": {
    "files.eol": "\n"
  },
  "[properties]": {
    "files.eol": "\n"
  },
  "[snbt]": {
    "files.eol": "\n"
  },
  "[toml]": {
    "files.eol": "\n"
  },
  "[powershell]": {
    "files.eol": "\r\n"
  },
  "[python]": {
    "files.eol": "\n"
  }
}
